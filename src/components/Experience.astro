---
/**
 * Experience — vertical timeline of jobs.
 */
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import type { Content } from '../data/site';

interface Props {
  content: Content;
}

const { content } = Astro.props;
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <SectionHeading title={content.experience.title} icon="briefcase" />

  <div class="relative mx-auto max-w-3xl ps-12">
    <!-- Timeline rail -->
    <span class="timeline-rail no-print" aria-hidden="true"></span>

    <ol class="space-y-8">
      {
        content.experience.jobs.map((job, i) => (
          <li class="reveal relative" style={`transition-delay: ${i * 90}ms`}>
            <span class="timeline-dot absolute -start-12 top-6">
              <Icon name="briefcase" size={16} />
            </span>

            <article class="card card-hover p-6 sm:p-8">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-bold sm:text-xl">{job.position}</h3>
                  <p class="mt-1 font-medium text-brand">{job.company}</p>
                </div>
                <span class="chip whitespace-nowrap">{job.period}</span>
              </div>

              <h4 class="mt-6 mb-3 text-sm font-semibold text-sub">
                {content.experience.tasks_title}
              </h4>
              <ul class="space-y-2.5">
                {job.tasks.map((task) => (
                  <li class="flex items-start gap-3 text-sm leading-6 text-ink/90">
                    <span class="mt-0.5 text-brand">
                      <Icon name="check-circle" size={16} />
                    </span>
                    <span>{task}</span>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>
