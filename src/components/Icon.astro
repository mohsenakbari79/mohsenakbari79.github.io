---
/**
 * Inline SVG icon set (stroke-based, Lucide-compatible paths).
 * Brand icons (GitHub, Telegram) use fill; Virgool reuses the logo file
 * from the previous site via <img>.
 */
export interface IconProps {
  name: string;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 20 } = Astro.props;

