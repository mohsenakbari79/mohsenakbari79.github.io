---
/**
 * Minimal footer with name, social profiles and navigation.
 */
import Icon from './Icon.astro';
import { socialLinks, navItems, type Locale } from '../data/site';

interface Props {
  lang: Locale;
  name: string;
  expertise: string;
}

const { lang, name, expertise } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="no-print mt-24 border-t border-line bg-card/50">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-10 sm:px-6 md:flex-row md:justify-between"
  >
    <div class="text-center md:text-start">
      <p class="font-bold">{name}</p>
      <p class="text-sm text-sub">{expertise}</p>
    </div>

    <nav class="flex items-center gap-4" aria-label="Footer">
      {
        navItems[lang].map((item) => (
          <a href={item.href} class="text-sm text-sub transition hover:text-brand">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label={link.name}
            title={link.name}
          >
            {link.icon === 'virgool' ? (
              <img src="/logovirgool.svg" alt="" width="18" height="18" class="opacity-80" />
            ) : (
              <Icon name={link.icon} size={18} />
            )}
          </a>
        ))
      }
    </div>
  </div>
  <div class="border-t border-line/60 py-4 text-center text-xs text-sub">
    © {year} {name}
  </div>
</footer>
