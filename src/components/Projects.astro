---
/**
 * Projects — selected project cards.
 */
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import type { Content } from '../data/site';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const p = content.project;
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <SectionHeading title={p.title} icon="folder" />

  <div class="grid gap-6 md:grid-cols-2">
    {
      content.projects.map((project, i) => (
        <article
          class="reveal card card-hover flex flex-col p-6 sm:p-7"
          style={`transition-delay: ${i * 70}ms`}
        >
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-bold leading-snug">
              {project.urls ? (
                <a
                  href={project.urls}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 transition hover:text-brand"
                >
                  {project.title}
                  <Icon name="external-link" size={14} />
                </a>
              ) : (
                project.title
              )}
            </h3>
          </div>

          <dl class="mt-3 space-y-1.5 text-sm">
            <div class="flex gap-2">
              <dt class="shrink-0 text-sub">{p.client}:</dt>
              <dd class="font-medium">{project.client}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="shrink-0 text-sub">{p.startDate}:</dt>
              <dd class="font-medium">{project.startDate}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="shrink-0 text-sub">{p.endDate}:</dt>
              <dd class="font-medium">{project.endDate}</dd>
            </div>
          </dl>

          <ul class="mt-5 space-y-2.5 border-t border-line pt-5">
            {project.description.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-6 text-ink/90">
                <span class="mt-0.5 text-brand">
                  <Icon name="check-circle" size={15} />
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-5">
            <p class="mb-2 text-xs font-semibold text-sub">{p.technologiesUsed}:</p>
            <ul class="flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <li class="chip text-xs" dir="ltr">
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
