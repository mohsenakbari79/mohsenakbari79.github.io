---
/**
 * Sticky header with navigation, language toggle and theme toggle.
 */
import Icon from './Icon.astro';
import { navItems, alternateHref, type Locale } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const items = navItems[lang];
const altHref = alternateHref(pathname, lang);
const altLabel = lang === 'fa' ? 'English' : 'فارسی';

/** Normalize a path so active-state comparison works with/without trailing slash. */
const normalize = (p: string) => (p.endsWith('/') && p !== '/' ? p.slice(0, -1) : p);
const current = normalize(pathname);
const isActive = (href: string) => normalize(href) === current;
---

<header class="no-print sticky top-0 z-50 border-b border-line/70 bg-page/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <!-- Brand -->
    <a href={items[0].href} class="group flex items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand to-brand-strong font-bold text-white shadow-md shadow-brand/30 transition group-hover:scale-105"
      >
        {lang === 'fa' ? 'م' : 'M'}
      </span>
      <span class="hidden text-lg font-bold tracking-tight sm:block">
        {lang === 'fa' ? 'محسن اکبری' : 'Mohsen Akbari'}
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-xl px-4 py-2 text-sm font-medium transition',
              isActive(item.href)
                ? 'bg-brand-soft text-brand'
                : 'text-sub hover:bg-card hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <a
        href={altHref}
        hreflang={lang === 'fa' ? 'en' : 'fa'}
        class="inline-flex h-10 items-center gap-2 rounded-xl border border-line bg-card px-3 text-sm font-medium text-sub transition hover:border-brand/40 hover:text-brand"
        aria-label={altLabel}
        title={altLabel}
      >
        <Icon name="globe" size={17} />
        <span class="hidden sm:inline">{altLabel}</span>
      </a>

      <button
        type="button"
        data-theme-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line bg-card text-sub transition hover:border-brand/40 hover:text-brand"
        aria-label={lang === 'fa' ? 'تغییر تم' : 'Toggle theme'}
      >
        <span class="theme-icon-sun"><Icon name="sun" size={18} /></span>
        <span class="theme-icon-moon"><Icon name="moon" size={18} /></span>
      </button>

      <!-- Mobile menu (details/summary — zero JS) -->
      <details class="relative md:hidden">
        <summary class="icon-btn cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />
          </svg>
          <span class="sr-only">Menu</span>
        </summary>
        <nav
          class="absolute end-0 top-12 w-48 rounded-2xl border border-line bg-card p-2 shadow-xl"
          aria-label="Mobile"
        >
          {
            items.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block rounded-xl px-4 py-2.5 text-sm font-medium transition',
                  isActive(item.href)
                    ? 'bg-brand-soft text-brand'
                    : 'text-sub hover:bg-page hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
