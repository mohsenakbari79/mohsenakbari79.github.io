---
/**
 * Resume (English) — education, experience, projects, courses, social links.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Education from '../../components/Education.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import Courses from '../../components/Courses.astro';
import Icon from '../../components/Icon.astro';
import { en } from '../../data/en';
---

<BaseLayout lang="en" content={en}>
  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <div class="no-print mb-4 flex justify-end">
      <button type="button" class="btn-ghost" onclick="window.print()">
        <Icon name="printer" size={17} />
        {en.header.title}
      </button>
    </div>
  </div>

  <Education content={en} />
  <Experience content={en} />
  <Projects content={en} />
  <Courses content={en} />

  <section id="social" class="no-print mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading title={en.social_media.title} icon="globe" />
    <div class="reveal flex justify-center">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>
